# --- RUNNER STAGE ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# 1. Copy public assets
COPY --from=builder /app/frontend/public ./public

# 2. Copy the standalone output from the nested directory
COPY --from=builder /app/frontend/.next/standalone/frontend ./

# 3. Copy the hoisted monorepo node_modules generated by Next.js
COPY --from=builder /app/frontend/.next/standalone/node_modules ./node_modules

# 4. Copy static Next.js assets into .next/static
COPY --from=builder /app/frontend/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
